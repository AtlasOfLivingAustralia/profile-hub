{
  "name": "Profiles CloudFormation Dev",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/ubuntu/.ssh,type=bind,consistency=cached,readonly"
  ],
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "aws-scripting-guy.cform",
        "eastman.vscode-cfn-nag",
        "kddejong.vscode-cfn-lint",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "redhat.vscode-yaml",
        "streetsidesoftware.code-spell-checker"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/pyenv/bin/python",
        "python.linting.enabled": true,
        "python.linting.pylintEnabled": false,
        "python.formatting.provider": "black",
        "cfnLint.path": "/opt/pyenv/bin/cfn-lint",
        "cfnNagLint.path": "cfn_nag",
        "aws.cloudformation.completion.enabled": false,
        "aws.cloudformation.diagnostics.cfnLint.path": "/opt/pyenv/bin/cfn-lint",
        "aws.cloudformation.diagnostics.cfnGuard.enabledRulePacks": [
          "wa-Security-Pillar",
          "acsc-essential-8"
        ],
        "files.associations": {
          "*.yaml": "yaml",
          "*.yml": "yaml"
        },
        "yaml.customTags": [
                "!And sequence",
                "!Base64 scalar",
                "!Cidr sequence",
                "!Condition scalar",
                "!Equals sequence",
                "!FindInMap sequence",
                "!GetAZs scalar",
                "!GetAtt scalar",
                "!GetAtt sequence",
                "!If sequence",
                "!ImportValue scalar",
                "!ImportValue sequence",
                "!ImportValue mapping",
                "!Join sequence",
                "!Not sequence",
                "!Or sequence",
                "!Ref scalar",
                "!Select sequence",
                "!Split sequence",
                "!Sub scalar",
                "!Sub sequence",
                "!Transform mapping",
                "!ValueOf sequence",
                "!ValueOfAll sequence"
              ]
      }
    }
  },
  "remoteUser": "ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/aws-cli:1": {},
    "ghcr.io/devcontainers/features/git:1": {}
  }
}
