    "@fortawesome/react-fontawesome": "^3.5.0",
    "@tanstack/react-query": "^5.104.1",
    "bootstrap": "^5.3.8",
    "dompurify": "^3.4.16",
    "jwt-decode": "^4.0.0",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.3.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.0",
    "react-intl": "^12.1.4",
    "react-oidc-context": "^3.3.1",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@biomejs/biome": "2.5.15",
