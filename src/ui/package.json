    "bootstrap": "^5.3.8",
    "jwt-decode": "^4.0.0",
    "nuqs": "^2.9.3",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.2.7",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.7",
    "react-intl": "^10.1.18",
    "react-oidc-context": "^3.3.1",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
